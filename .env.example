# Render backend origin, no trailing slash.
# Example: https://emailautomation-backend.onrender.com
BACKEND_URL=

# Same AUTH_SECRET as the backend. The dashboard checks the session cookie
# before it renders a page. It does not talk to Supabase.
AUTH_SECRET=

# Dashboard timezone. Must match the backend value.
NEXT_PUBLIC_OPERATOR_TIMEZONE=Asia/Karachi
